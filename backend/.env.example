# Copy this file to .env and fill in the values. Never commit .env.

PORT=5000

# MongoDB connection string (e.g. from MongoDB Atlas)
MONGO_URI=

# Long random string used to sign login tokens
JWT_SECRET=

# Frontend URL(s) allowed by CORS and used in password-reset links.
# Several origins can be comma-separated.
# Local:      http://localhost:5173
# Production: https://your-frontend.vercel.app
FRONTEND_URL=http://localhost:5173

# SMTP server for password-reset emails
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Path to the Firebase service-account JSON (only for Google login)
FIREBASE_SERVICE_ACCOUNT_PATH=
