# Copy this file to .env and fill in the values.
# Vite only exposes variables that start with VITE_ — never put secrets here,
# everything in this file ends up in the browser bundle.

# Backend base URL (no trailing slash)
# Local:      http://localhost:5000
# Production: https://your-backend.onrender.com
VITE_API_URL=http://localhost:5000

# Firebase web app config (Firebase console → Project settings → Your apps)
# Needed only for "Continue with Google".
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
